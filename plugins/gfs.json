      {
        "id": "ID_profiles_to_sync",
        "title": "要同步的配置",
        "description": "下拉选项会根据当前 GUI 中的配置自动更新；不选择时默认同步全部配置",
        "key": "ProfileIds",
        "component": "MultipleSelect",
        "value": [],
        "options": []
      },
      {
        "id": "ID_upload_windows",
        "title": "上传 Windows 配置",
        "description": "开启后生成并上传 名称_windows.json；可与其他版本同时勾选",
        "key": "UploadWindows",
        "component": "Switch",
        "value": false,
        "options": []
      },
      {
        "id": "ID_windows_upload_script",
        "title": "Windows配置上传前脚本",
        "description": "仅在对应上传开关开启时执行；target 为 windows，onUpload(config, profile, target) 必须返回配置对象，可自行修改。",
        "key": "WindowsUploadScript",
        "component": "CodeEditor",
        "value": "const onUpload = async (config, profile, target) => {\n  const inbounds = Array.isArray(config.inbounds) ? config.inbounds : []\n  for (const inbound of inbounds) {\n    if (inbound && inbound.type === 'tun') {\n      inbound.auto_route = true\n      // Windows / macOS 不支持 Linux 的 auto_redirect；由系统自动分配 TUN 名称。\n      delete inbound.interface_name\n      for (const key of Object.keys(inbound)) {\n        if (key === 'auto_redirect' || key.startsWith('auto_redirect_')) delete inbound[key]\n      }\n    }\n  }\n  return config\n}",
        "options": []
      },
      {
        "id": "ID_upload_linux",
        "title": "上传 Linux 配置",
        "description": "开启后生成并上传 名称_linux.json；可与其他版本同时勾选",
        "key": "UploadLinux",
        "component": "Switch",
        "value": false,
        "options": []
      },
      {
        "id": "ID_linux_upload_script",
        "title": "Linux配置上传前脚本",
        "description": "仅在对应上传开关开启时执行；target 为 linux，onUpload(config, profile, target) 必须返回配置对象，可自行修改。",
        "key": "LinuxUploadScript",
        "component": "CodeEditor",
        "value": "const onUpload = async (config, profile, target) => {\n  const inbounds = Array.isArray(config.inbounds) ? config.inbounds : []\n  for (const inbound of inbounds) {\n    if (inbound && inbound.type === 'tun') {\n      inbound.auto_route = true\n      inbound.auto_redirect = true\n    }\n  }\n  return config\n}",
        "options": []
      },
      {
        "id": "ID_upload_macos",
        "title": "上传 macOS 配置",
        "description": "开启后生成并上传 名称_macos.json；可与其他版本同时勾选",
        "key": "UploadMacOS",
        "component": "Switch",
        "value": false,
        "options": []
      },
      {
        "id": "ID_macos_upload_script",
        "title": "macOS配置上传前脚本",
        "description": "仅在对应上传开关开启时执行；target 为 macos，onUpload(config, profile, target) 必须返回配置对象，可自行修改。",
        "key": "MacOSUploadScript",
        "component": "CodeEditor",
        "value": "const onUpload = async (config, profile, target) => {\n  const inbounds = Array.isArray(config.inbounds) ? config.inbounds : []\n  for (const inbound of inbounds) {\n    if (inbound && inbound.type === 'tun') {\n      inbound.auto_route = true\n      // Windows / macOS 不支持 Linux 的 auto_redirect；由系统自动分配 TUN 名称。\n      delete inbound.interface_name\n      for (const key of Object.keys(inbound)) {\n        if (key === 'auto_redirect' || key.startsWith('auto_redirect_')) delete inbound[key]\n      }\n    }\n  }\n  return config\n}",
        "options": []
      }
    ],
    "disabled": false,
    "install": false,
    "installed": false
  },
